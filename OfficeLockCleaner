import os
import sys
import time
import logging
import subprocess
import random
import ctypes
import traceback
from pathlib import Path
from datetime import datetime
import tkinter as tk
from tkinter import filedialog, messagebox, ttk, scrolledtext

# Подавляем появление окон консоли при вызове subprocess (Windows)
if sys.platform == 'win32':
    CREATE_NO_WINDOW = 0x08000000
else:
    CREATE_NO_WINDOW = 0

try:
    from tkinterdnd2 import DND_FILES, TkinterDnD
    HAS_DND = True
except ImportError:
    HAS_DND = False

APP_NAME = "OfficeLockCleaner"
LOG_DIR = Path(os.environ.get('TEMP', '.')) / 'OfficeLockCleaner_Logs'
LOG_DIR.mkdir(exist_ok=True)


class OfficeUnlockerApp:
    def __init__(self, root):
        self.root = root
        self.root.title(f"{APP_NAME} – Удаление блокировок офисных файлов")
        self.root.geometry("740x520")
        self.root.minsize(650, 400)
        self.root.resizable(True, True)

        self.is_admin = self.check_admin()
        if not self.is_admin:
            messagebox.showwarning(
                "Недостаточно прав",
                "Программа запущена без прав администратора.\n"
                "Некоторые файлы могут не удалиться.\n"
                "Рекомендуется перезапустить от имени администратора."
            )

        self.set_icon()
        self.setup_styles()
        self.setup_logging()
        self.logger.info("=" * 60)
        self.logger.info(f"Запуск {APP_NAME} v2.4")
        self.logger.info(f"Права администратора: {self.is_admin}")

        self.processing = False
        self.build_ui()
        self.setup_hotkeys()

        sys.excepthook = self.global_exception_handler

    def global_exception_handler(self, exc_type, exc_value, exc_traceback):
        error_msg = "".join(traceback.format_exception(exc_type, exc_value, exc_traceback))
        self.logger.critical(f"Необработанное исключение:\n{error_msg}")
        messagebox.showerror(
            "Критическая ошибка",
            f"Программа столкнулась с ошибкой:\n\n{exc_value}\n\n"
            "Подробности записаны в лог-файл."
        )

    def check_admin(self):
        try:
            return ctypes.windll.shell32.IsUserAnAdmin()
        except:
            return False

    def set_icon(self):
        try:
            base_path = getattr(sys, '_MEIPASS', os.path.dirname(sys.argv[0]))
            icon_path = Path(base_path) / "icon.ico"
            if icon_path.exists():
                self.root.iconbitmap(default=str(icon_path))
        except:
            pass

    def setup_styles(self):
        self.colors = {
            'primary': '#2B5797',
            'primary_hover': '#1E3F6F',
            'success': '#4CAF50',
            'danger': '#D32F2F',
            'bg_white': '#FFFFFF',
            'bg_frame': '#E9ECEF',
            'text_primary': '#2C3E50',
            'text_secondary': '#5A6C7D',
            'text_light': '#95A5A6',
            'text_white': '#FFFFFF',
        }
        self.fonts = {
            'title': ('Segoe UI', 12, 'normal'),
            'body': ('Segoe UI', 9, 'normal'),
            'small': ('Segoe UI', 8, 'normal'),
            'button': ('Segoe UI', 9, 'normal'),
        }

    def setup_logging(self):
        log_file = LOG_DIR / f'unlock_office_{datetime.now().strftime("%Y%m%d")}.log'
        logging.basicConfig(
            level=logging.DEBUG,
            format='%(asctime)s - %(levelname)s - %(message)s',
            handlers=[
                logging.FileHandler(log_file, encoding='utf-8'),
                logging.StreamHandler()
            ]
        )
        self.logger = logging.getLogger(__name__)

    def build_ui(self):
        main_frame = ttk.Frame(self.root, padding="15")
        main_frame.pack(fill='both', expand=True)

        tk.Label(
            main_frame,
            text="Удаление блокировок офисных файлов",
            font=self.fonts['title'],
            fg=self.colors['text_primary']
        ).pack(pady=(0, 5))

        tk.Label(
            main_frame,
            text="Удаляет временные файлы блокировки (~$…, .~lock.…) для Microsoft Office, Р7-Офис, LibreOffice и др.",
            font=self.fonts['small'],
            fg=self.colors['text_secondary']
        ).pack(pady=(0, 15))

        ctrl_frame = ttk.Frame(main_frame)
        ctrl_frame.pack(fill='x', pady=(0, 10))

        for text, cmd in [
            ("Добавить файл", self.add_files),
            ("Добавить папку", self.add_folder),
            ("Очистить список", self.clear_list),
        ]:
            btn = tk.Button(
                ctrl_frame,
                text=text,
                command=cmd,
                font=self.fonts['button'],
                bg=self.colors['bg_white'],
                relief='flat',
                padx=10, pady=5,
                cursor='hand2'
            )
            btn.pack(side='left', padx=(0, 5))
            btn.bind('<Enter>', lambda e, b=btn: b.config(bg=self.colors['bg_frame']))
            btn.bind('<Leave>', lambda e, b=btn: b.config(bg=self.colors['bg_white']))

        list_frame = ttk.LabelFrame(main_frame, text="Список файлов для обработки", padding="5")
        list_frame.pack(fill='both', expand=True, pady=(0, 10))

        self.files_text = scrolledtext.ScrolledText(
            list_frame,
            height=8,
            font=self.fonts['body'],
            bg=self.colors['bg_white'],
            relief='solid',
            bd=1,
            wrap='none'
        )
        self.files_text.pack(fill='both', expand=True)

        if HAS_DND:
            self.files_text.drop_target_register(DND_FILES)
            self.files_text.dnd_bind('<<Drop>>', self.on_drop)

        status_frame = ttk.Frame(main_frame)
        status_frame.pack(fill='x', pady=(5, 0))

        self.status_var = tk.StringVar(value="Готов к работе. Добавьте файлы или папки, или введите пути вручную.")
        tk.Label(
            status_frame,
            textvariable=self.status_var,
            font=self.fonts['small'],
            fg=self.colors['text_secondary'],
            anchor='w'
        ).pack(side='left', fill='x', expand=True)

        self.progress = ttk.Progressbar(status_frame, mode='indeterminate', length=150)
        self.progress.pack(side='right', padx=(10, 0))
        self.progress.pack_forget()

        self.unlock_btn = tk.Button(
            main_frame,
            text="Разблокировать",
            command=self.unlock_all,
            font=self.fonts['button'],
            bg=self.colors['primary'],
            fg=self.colors['text_white'],
            relief='flat',
            padx=30, pady=8,
            cursor='hand2'
        )
        self.unlock_btn.pack(pady=(10, 5))
        self.unlock_btn.bind('<Enter>', lambda e: self.unlock_btn.config(bg=self.colors['primary_hover']))
        self.unlock_btn.bind('<Leave>', lambda e: self.unlock_btn.config(bg=self.colors['primary']))

        tk.Label(
            main_frame,
            text="Ctrl+O - добавить файлы | Ctrl+F - добавить папку | Ctrl+U - разблокировать | Esc - выход",
            font=self.fonts['small'],
            fg=self.colors['text_light']
        ).pack(pady=(5, 0))

    # ---------- Работа со списком ----------
    def get_files_from_text(self):
        content = self.files_text.get('1.0', tk.END).strip()
        if not content:
            return []
        lines = [line.strip() for line in content.splitlines() if line.strip()]
        return [self.normalize_path(p) for p in lines]

    def set_files_to_text(self, file_list):
        self.files_text.delete('1.0', tk.END)
        if file_list:
            self.files_text.insert('1.0', '\n'.join(file_list))
        else:
            self.files_text.insert('1.0', "(список пуст)")

    def add_files(self):
        filenames = filedialog.askopenfilenames(
            title="Выберите файлы для разблокировки",
            filetypes=[("Все файлы", "*.*")]
        )
        if not filenames:
            return
        current = self.get_files_from_text()
        added = 0
        for f in filenames:
            norm = self.normalize_path(f)
            if norm not in current:
                current.append(norm)
                added += 1
        if added:
            self.set_files_to_text(current)
            self.status_var.set(f"Добавлено файлов: {added}")
            self.logger.info(f"Добавлено файлов: {filenames}")

    def add_folder(self):
        folder = filedialog.askdirectory(title="Выберите папку для поиска блокировок")
        if not folder:
            return
        folder = self.normalize_path(folder)
        lock_files = self.scan_folder_for_locks(folder)
        if not lock_files:
            messagebox.showinfo("Информация", "В выбранной папке не найдено файлов блокировки.")
            return
        current = self.get_files_from_text()
        added = 0
        for f in lock_files:
            if f not in current:
                current.append(f)
                added += 1
        if added:
            self.set_files_to_text(current)
            self.status_var.set(f"Найдено и добавлено {added} файлов блокировки")
            self.logger.info(f"Из папки {folder} добавлено {added} блокировочных файлов")

    def scan_folder_for_locks(self, folder):
        lock_files = []
        try:
            for root, dirs, files in os.walk(folder):
                for f in files:
                    if f.startswith('~$') or f.startswith('.~lock.'):
                        full = os.path.join(root, f)
                        if os.path.isfile(full):
                            lock_files.append(full)
        except Exception as e:
            self.logger.error(f"Ошибка сканирования папки {folder}: {e}")
            messagebox.showerror("Ошибка", f"Не удалось просканировать папку:\n{e}")
        return lock_files

    def clear_list(self):
        self.set_files_to_text([])
        self.status_var.set("Список очищен")

    def on_drop(self, event):
        if not HAS_DND:
            return
        data = event.data
        if isinstance(data, str):
            files = self.root.tk.splitlist(data)
            current = self.get_files_from_text()
            added = 0
            for f in files:
                f = f.strip('{}')
                norm = self.normalize_path(f)
                if os.path.exists(norm) and norm not in current:
                    current.append(norm)
                    added += 1
            if added:
                self.set_files_to_text(current)
                self.status_var.set(f"Добавлено через Drag&Drop: {added}")

    def normalize_path(self, path):
        if not path:
            return path
        path = path.replace('/', '\\').strip()
        if path.startswith('"') and path.endswith('"'):
            path = path[1:-1]
        return path

    # ---------- Универсальное завершение офисных процессов ----------
    def kill_office_processes(self):
        """Завершает все процессы популярных офисных пакетов."""
        office_masks = [
            'r7*',          # Р7-Офис
            'winword*',     # Microsoft Word
            'excel*',       # Microsoft Excel
            'powerpnt*',    # Microsoft PowerPoint
            'soffice*'      # LibreOffice / OpenOffice
        ]
        try:
            # Проверяем, есть ли хоть один процесс
            found_any = False
            for mask in office_masks:
                cmd_check = ['tasklist', '/fi', f'imagename eq {mask}', '/fo', 'csv']
                result = subprocess.run(
                    cmd_check,
                    capture_output=True,
                    text=True,
                    timeout=5,
                    creationflags=CREATE_NO_WINDOW if sys.platform == 'win32' else 0
                )
                # Проверяем, что в выводе есть имя процесса (без звёздочки)
                base_name = mask.rstrip('*')
                if base_name.lower() in result.stdout.lower():
                    found_any = True
                    break

            if not found_any:
                self.logger.info("Процессы офисных пакетов не найдены")
                return True

            self.logger.info("Обнаружены процессы офисных пакетов, завершаем...")
            for attempt in range(3):
                for mask in office_masks:
                    subprocess.run(
                        ['taskkill', '/f', '/im', mask],
                        capture_output=True,
                        timeout=5,
                        creationflags=CREATE_NO_WINDOW if sys.platform == 'win32' else 0
                    )
                time.sleep(1)

                # Проверяем, остались ли процессы
                still_running = False
                for mask in office_masks:
                    check = subprocess.run(
                        ['tasklist', '/fi', f'imagename eq {mask}', '/fo', 'csv'],
                        capture_output=True,
                        text=True,
                        timeout=5,
                        creationflags=CREATE_NO_WINDOW if sys.platform == 'win32' else 0
                    )
                    base_name = mask.rstrip('*')
                    if base_name.lower() in check.stdout.lower():
                        still_running = True
                        break

                if not still_running:
                    self.logger.info("Все процессы офисных пакетов завершены")
                    return True
                self.logger.warning(f"Попытка {attempt+1}: процессы ещё есть")

            self.logger.warning("Не удалось завершить все процессы, продолжаем удаление")
            return False
        except Exception as e:
            self.logger.error(f"Ошибка при завершении процессов: {e}")
            return False

    # ---------- Поиск блокировок ----------
    def find_lock_files(self, file_path):
        try:
            folder = os.path.dirname(file_path)
            if not folder or not os.path.exists(folder):
                self.logger.warning(f"Папка не существует: {folder}")
                return []
            base = os.path.basename(file_path)
            name, ext = os.path.splitext(base)

            lock_files = set()

            for pat in [f".~lock.{base}#", f".~lock.{base}", f"~${base}"]:
                p = os.path.join(folder, pat)
                if os.path.isfile(p):
                    lock_files.add(p)

            for entry in os.listdir(folder):
                full = os.path.join(folder, entry)
                if not os.path.isfile(full):
                    continue
                entry_lower = entry.lower()
                if entry_lower.startswith('~$') or entry_lower.startswith('.~lock.'):
                    test_name = entry
                    for prefix in ['~$', '.~lock.']:
                        if test_name.startswith(prefix):
                            test_name = test_name[len(prefix):]
                    if test_name.endswith('#'):
                        test_name = test_name[:-1]
                    test_base, _ = os.path.splitext(test_name)
                    if test_base and (test_base in name or name in test_base):
                        lock_files.add(full)

            return list(lock_files)
        except Exception as e:
            self.logger.error(f"Ошибка в find_lock_files для {file_path}: {e}")
            return []

    # ---------- Удаление ----------
    def force_delete_file(self, filepath):
        if not os.path.exists(filepath):
            return True, "Файл уже удалён"

        # 1. Python
        try:
            os.chmod(filepath, 0o777)
            os.remove(filepath)
            if not os.path.exists(filepath):
                return True, "Удалён через os.remove"
        except Exception as e:
            self.logger.debug(f"os.remove не удался: {e}")

        # 2. PowerShell
        try:
            ps_cmd = [
                'powershell', '-Command',
                f'Remove-Item -LiteralPath "{filepath}" -Force -ErrorAction Stop'
            ]
            subprocess.run(
                ps_cmd,
                capture_output=True,
                timeout=10,
                check=True,
                creationflags=CREATE_NO_WINDOW if sys.platform == 'win32' else 0
            )
            if not os.path.exists(filepath):
                return True, "Удалён через PowerShell"
        except Exception as e:
            self.logger.debug(f"PowerShell не удался: {e}")

        # 3. Переименование
        try:
            temp_dir = os.path.dirname(filepath)
            if not temp_dir:
                temp_dir = os.getcwd()
            temp_name = os.path.join(temp_dir, f'~del_{random.randint(10000,99999)}.tmp')
            os.rename(filepath, temp_name)
            os.remove(temp_name)
            if not os.path.exists(filepath):
                return True, "Удалён через переименование"
        except Exception as e:
            self.logger.debug(f"Переименование не удалось: {e}")

        # 4. cmd
        try:
            cmd = ['cmd', '/c', 'del', '/f', '/q', filepath]
            subprocess.run(
                cmd,
                capture_output=True,
                timeout=5,
                check=True,
                creationflags=CREATE_NO_WINDOW if sys.platform == 'win32' else 0
            )
            if not os.path.exists(filepath):
                return True, "Удалён через cmd"
        except Exception as e:
            self.logger.debug(f"cmd не удался: {e}")

        if os.path.exists(filepath):
            return False, "Не удалось удалить (файл занят или недостаточно прав)"
        return True, "Удалён"

    # ---------- Основная операция ----------
    def unlock_all(self):
        if self.processing:
            return

        file_paths = self.get_files_from_text()
        if not file_paths:
            messagebox.showwarning("Предупреждение", "Список файлов пуст. Добавьте файлы или папки.")
            return

        msg = f"Будет обработано {len(file_paths)} записей.\n\n"
        msg += "Программа попытается:\n"
        msg += "• Завершить все процессы офисных пакетов (Word, Excel, PowerPoint, Р7, LibreOffice)\n"
        msg += "• Найти и удалить связанные файлы блокировки\n"
        msg += "• Если запись является файлом блокировки – удалить его напрямую\n\n"
        msg += "Продолжить?"
        if not messagebox.askyesno("Подтверждение", msg):
            return

        self.processing = True
        self.unlock_btn.config(state='disabled')
        self.progress.pack(side='right', padx=(10, 0))
        self.progress.start(10)

        try:
            self.status_var.set("Завершение процессов офисных пакетов...")
            self.root.update()
            self.kill_office_processes()

            total = len(file_paths)
            success_count = 0
            error_list = []

            for idx, path in enumerate(file_paths, 1):
                self.status_var.set(f"Обработка {idx}/{total}: {os.path.basename(path)}")
                self.root.update()
                self.logger.info(f"Обработка: {path}")

                try:
                    base = os.path.basename(path)
                    is_lock_file = base.startswith('~$') or base.startswith('.~lock.')

                    if is_lock_file:
                        self.logger.info(f"Прямое удаление блокировочного файла: {path}")
                        succ, msg = self.force_delete_file(path)
                        if succ:
                            success_count += 1
                        else:
                            error_list.append((path, msg))
                    else:
                        locks = self.find_lock_files(path)
                        if not locks:
                            self.logger.info(f"Для {path} блокировок не найдено")
                            continue
                        for lock in locks:
                            succ, msg = self.force_delete_file(lock)
                            if succ:
                                success_count += 1
                            else:
                                error_list.append((lock, msg))
                            self.status_var.set(f"Удалено {success_count} файлов")
                            self.root.update()
                            time.sleep(0.05)
                except Exception as e:
                    self.logger.error(f"Критическая ошибка при обработке {path}: {e}")
                    error_list.append((path, str(e)))

            if error_list:
                err_msg = "Не удалось удалить следующие файлы:\n\n"
                for f, e in error_list[:5]:
                    err_msg += f"• {os.path.basename(f)}: {e}\n"
                if len(error_list) > 5:
                    err_msg += f"\n... и ещё {len(error_list)-5} ошибок"
                err_msg += "\n\nРекомендации:\n"
                err_msg += "• Закройте офисные программы вручную\n"
                err_msg += "• Запустите программу от имени администратора\n"
                err_msg += "• Проверьте права доступа к папке"
                messagebox.showerror("Частичный успех", err_msg)
                self.status_var.set(f"Удалено {success_count} файлов, ошибок {len(error_list)}")
            else:
                messagebox.showinfo("Готово", f"✅ Все найденные блокировки удалены.\nОбработано записей: {total}")
                self.status_var.set("Разблокировка завершена успешно")
        except Exception as e:
            self.logger.error(f"Неожиданная ошибка в unlock_all: {e}")
            traceback.print_exc()
            messagebox.showerror("Ошибка", f"Произошла непредвиденная ошибка:\n{e}\n\nПодробности в логе.")
        finally:
            self.progress.stop()
            self.progress.pack_forget()
            self.unlock_btn.config(state='normal')
            self.processing = False

    # ---------- Горячие клавиши и выход ----------
    def setup_hotkeys(self):
        self.root.bind('<Control-o>', lambda e: self.add_files())
        self.root.bind('<Control-f>', lambda e: self.add_folder())
        self.root.bind('<Control-u>', lambda e: self.unlock_all())
        self.root.bind('<Escape>', lambda e: self.on_closing())

    def on_closing(self):
        self.logger.info("Приложение закрыто")
        self.root.destroy()


if __name__ == "__main__":
    if HAS_DND:
        root = TkinterDnD.Tk()
    else:
        root = tk.Tk()
    app = OfficeUnlockerApp(root)
    root.protocol("WM_DELETE_WINDOW", app.on_closing)
    root.mainloop()
